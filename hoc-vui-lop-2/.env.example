# Sao chép file này thành .env.local rồi điền thông tin project Supabase
# (Supabase > Project Settings > API). Để trống => web chạy CHẾ ĐỘ DEMO (dữ liệu nằm trong trình duyệt).
VITE_SUPABASE_URL=
# Dùng "anon public key" hoặc "publishable key". TUYỆT ĐỐI không dùng service_role / secret key.
VITE_SUPABASE_ANON_KEY=
